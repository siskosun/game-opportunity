{
  "schema_version": "1.0",
  "project": {
    "id": "echo-tide-visual-pilot",
    "name": "叠影潮落点预告视觉试点（未批准草案）",
    "domain": "game-art",
    "owner": "待独立视觉评审者确认"
  },
  "version": "0.1.0",
  "status": "draft",
  "scope": {
    "medium": "H5 Canvas 2D 游戏运行时视觉",
    "view": "侧视单屏平台跳跃",
    "target_platform": "桌面浏览器和 390×844 / 844×390 视口测试",
    "asset_types": [
      "ui",
      "prop",
      "environment"
    ]
  },
  "intent": {
    "summary": "只围绕 ET-VISUAL-01 落点提示和移动轨道的游戏内可读性整理候选规范；不修改游戏机制和真实碰撞。",
    "pillars": [
      "游戏内目标可见性优先于静态图的装饰性",
      "保留已有夜潮氛围但不锁定未批准的风格",
      "手机显示尺寸与独立人工观察共同决定最终质量"
    ],
    "avoid": [
      "把源码配色当作主美已批准规则",
      "用 VLM 自评替代人工审查",
      "单凭整页截图确认首屏完整显示",
      "把外观修改伪装成游戏核心机制调整"
    ]
  },
  "tokens": {
    "colors": {
      "sky_top": "#071018",
      "sky_mid": "#0c2a32",
      "sky_low": "#11464a",
      "forecast_rail": "#e8ffad",
      "first_jump": "#ffe7b5",
      "precision": "#aefbdc",
      "warning": "#ffb089"
    },
    "fonts": {
      "observed_ui": {
        "family": "WenQuanYi Micro Hei",
        "fallback": [
          "Noto Sans CJK SC",
          "Microsoft YaHei",
          "system-ui",
          "sans-serif"
        ]
      }
    }
  },
  "rules": [
    {
      "id": "ET-UI-01",
      "scope": [
        "ui",
        "prop"
      ],
      "strength": "must",
      "statement": "以当前真实可碰撞目标为依据绘制落点预告；真实状态尚未产生前，不应让视觉伪装成已经存在的桥。",
      "rationale": "预测目标必须与同一游戏状态的可达目标及碰撞保持一致，避免用美术假象误导玩家。",
      "allowed_variation": [
        "改变虚线节奏、指示框材质或辅助符号，但不得改变预测目标的几何位置或生成时机。"
      ],
      "evidence": [
        "ET-STYLE-DESKTOP",
        "ET-CONTEXT-AFTER-INPUT"
      ],
      "verification": "technical",
      "status": "proposed"
    },
    {
      "id": "ET-UI-02",
      "scope": [
        "ui",
        "prop"
      ],
      "strength": "should",
      "statement": "预告中的可落脚区域、危险水面和目标状态应具有可识别差异，不仅依赖颜色区分。",
      "rationale": "不同显示环境和视觉感知条件下仍需要辨认下一步操作。",
      "allowed_variation": [
        "可以增加边缘描线、虚线形状、箭头或明暗层级；不能增添未经确认的新状态。"
      ],
      "evidence": [
        "ET-STYLE-DESKTOP",
        "ET-CONTEXT-PORTRAIT"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "ET-UI-03",
      "scope": [
        "ui"
      ],
      "strength": "must",
      "statement": "在预定最小真实显示尺寸下检查 HUD、提示和危险反馈的可辨认性；不以 960×540 绘图缓冲区字体大小代替屏幕上字体大小。",
      "rationale": "390×844 的画布实际宽度为 358 CSS px，缓冲区 12–13px 字体实际缩放到约 4.48–4.85px，不能预设可读。",
      "allowed_variation": [
        "可改为 DOM 提示、放大文字、提炼短句或调整布局；不能掩盖原状态信息。"
      ],
      "evidence": [
        "ET-CONTEXT-PORTRAIT"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "ET-UI-04",
      "scope": [
        "ui"
      ],
      "strength": "must",
      "statement": "在 844×390 视口下，游戏主体和关键角色/操作反馈应在同一可见区域中，不能只凭整页截图认定玩家看到了完整游戏。",
      "rationale": "已核实 844×390 首屏只显示游戏画布约 46.1%，角色通常在下方被遮挡。",
      "allowed_variation": [
        "可折叠引导文案、压缩工具条、提供适配横屏的画布高度；需保留游戏内容和可用操作。"
      ],
      "evidence": [
        "ET-CONTEXT-LANDSCAPE"
      ],
      "verification": "technical",
      "status": "proposed"
    },
    {
      "id": "ET-UI-05",
      "scope": [
        "ui",
        "environment"
      ],
      "strength": "should",
      "statement": "以当前深蓝/青绿夜潮背景、亮青预告和暖金目标为已观察的参考色彩，不推断其已获得主美批准。",
      "rationale": "源码与运行截图已记录颜色的现有角色；未来色彩变化需要任务范围和评价确认。",
      "allowed_variation": [
        "可根据可读性更改局部对比、描边、背景亮度；避免一刀切锁定所有色值。"
      ],
      "evidence": [
        "ET-STYLE-DESKTOP"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "ET-UI-06",
      "scope": [
        "ui",
        "prop"
      ],
      "strength": "should",
      "statement": "每次局部修改后重新检查角色与平台视觉身份、提示层级和动作连续性，不以局部问题修好代替全画面通过。",
      "rationale": "返工应避免在未修改区域引入新缺陷或破坏已正确的预测/反馈关系。",
      "allowed_variation": [
        "可以两轮复查作为检查点，失败时回到生成输入或放弃修复。"
      ],
      "evidence": [
        "ET-CONTEXT-AFTER-INPUT",
        "ET-STYLE-DESKTOP"
      ],
      "verification": "visual",
      "status": "proposed"
    }
  ],
